# ---- Application ----
APP_NAME="ALPHA Global Shipping & Logistics"
APP_ENV=local            # local | production
APP_DEBUG=true           # set false in production
APP_URL=http://localhost:8000

# ---- Database (MySQL / MariaDB) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alpha_gsl
DB_USERNAME=root
DB_PASSWORD=

# ---- Mail ----
# MAIL_DRIVER: log (writes to storage/logs/mail.log) | smtp | mail (PHP mail())
MAIL_DRIVER=log
MAIL_HOST=mail.alphagsl.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl      # ssl | tls | none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@alphagsl.com
MAIL_FROM_NAME="ALPHA Global Shipping"

# ---- Spam protection (optional) ----
# Leave blank to use honeypot + rate limiting only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
